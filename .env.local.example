# .env.local.example
# Copy to .env.local (gitignored) and fill in real values for local docker-compose
# development. .env.local is auto-loaded by docker-compose.dev.yml.
#
# NEVER commit .env.local — secrets there grant access to whatever local
# database/cloud creds you've wired up.

# X-API-Key the local API expects. Generate a strong one — keys are length-
# checked by plugins/auth.js (warns under 32 chars).
#   openssl rand -hex 32
APPCLOUD_API_KEY=

# AES-256-GCM key used by utils/encrypt.js to encrypt cloud / connector secrets
# at rest. ROTATING THIS without re-encrypting existing rows will surface as
# DecryptionError at read time (rows replaced with null + __decryptErrors).
#   openssl rand -hex 32
APPCLOUD_ENCRYPTION_KEY=

# Optional: separate admin-tier key required for /audit/* and /discovery/debug/*.
# Routes flagged `config.requireAdmin: true` 503 when this is unset. Setting
# it equal to APPCLOUD_API_KEY is allowed but defeats the tier separation.
#   openssl rand -hex 32
APPCLOUD_ADMIN_API_KEY=

# Optional: set to comma-separated list of allowed CORS origins. Default
# covers local-dev (localhost:3000/5173/8080 + appcloud.local). Tighten in
# prod to the exact UI/dashboard origin.
# APPCLOUD_ALLOWED_ORIGINS=https://appcloud.example.com

# Optional rate-limit overrides — defaults are 300/min global, 5/min on AI
# routes, 2/min on /discovery/scan/{aws,azure,gcp}, 1/5min on /scan/all.
# APPCLOUD_RATE_LIMIT_MAX=300
# APPCLOUD_RATE_LIMIT_WINDOW=1 minute
