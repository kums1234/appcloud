{
  "name": "neo4j-fastify-api",
  "version": "1.0.0",
  "description": "Fastify REST API for Neo4j infrastructure graph",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest --testPathIgnorePatterns '/integration/'",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --testPathPattern '/integration/'",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.600.0",
    "@aws-sdk/client-ecs": "^3.600.0",
    "@aws-sdk/client-eks": "^3.600.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.600.0",
    "@aws-sdk/client-elasticache": "^3.600.0",
    "@aws-sdk/client-lambda": "^3.600.0",
    "@aws-sdk/client-rds": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@azure/arm-appservice": "^14.1.0",
    "@azure/arm-compute": "^21.6.0",
    "@azure/arm-containerservice": "^20.0.0",
    "@azure/arm-network": "^33.3.0",
    "@azure/arm-rediscache": "^8.2.0",
    "@azure/arm-resourcegraph": "^4.2.1",
    "@azure/arm-resources": "^5.2.0",
    "@azure/arm-sql": "^10.0.0",
    "@azure/identity": "^4.3.0",
    "@azure/monitor-query": "^1.3.3",
    "@azure/storage-blob": "^12.17.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^8.3.0",
    "@fastify/sensible": "^5.5.0",
    "@google-cloud/compute": "^6.8.0",
    "@google-cloud/container": "^5.11.0",
    "@google-cloud/resource-manager": "^5.2.0",
    "@google-cloud/storage": "^7.11.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.1",
    "fastify": "^4.26.0",
    "googleapis": "^140.0.0",
    "neo4j-driver": "^5.18.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@testcontainers/neo4j": "^10.10.4",
    "@testcontainers/postgresql": "^10.10.4",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "testcontainers": "^10.10.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000,
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  }
}
