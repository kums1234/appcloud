# AI Provider — pick ONE and uncomment / fill in its block below.
#   ollama       — free, local. Default. Works without any external API key.
#   anthropic    — claude-* models, paid.
#   azure_openai — your Azure OpenAI deployment.
#   gemini       — Google Gemini via OpenAI-compat. Generous free tier.
#   groq         — Groq via OpenAI-compat. Largest free daily req/day.
AI_PROVIDER=ollama

# ─── Ollama (default, free) ──────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ─── Gemini (free, no card) ──────────────────────────────────
# Get a key at https://aistudio.google.com/ — no card required.
# Free tier (May 2026):
#   gemini-2.5-flash-lite — 15 RPM, 1,000 req/day  ← recommended for agent runs
#   gemini-2.5-flash      — 10 RPM, 250 req/day
#   gemini-2.5-pro        —  5 RPM, 100 req/day
# All three share a 250K TPM and the 1M-token context window.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# ─── Groq (free, no card) ────────────────────────────────────
# Get a key at https://console.groq.com/ — no card required.
# Free tier (May 2026):
#   llama-3.1-8b-instant     — 30 RPM, 6K TPM, 14,400 req/day, 500K tokens/day
#   llama-3.3-70b-versatile  — 30 RPM, 6K TPM,  1,000 req/day
# Reset at midnight UTC.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# ─── Azure OpenAI (optional) ─────────────────────────────────
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_KEY=your-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-10-21

# ─── Anthropic (optional) ────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ─── AppCloud API ─────────────────────────────────────────────
APPCLOUD_API_URL=http://localhost:3000
# X-API-Key — bootstrap key from the API container, or one minted via /admin/api-keys
APPCLOUD_API_KEY=
# Optional X-Tenant-Slug — only set for super-admin keys acting on a non-default tenant
# APPCLOUD_TENANT_SLUG=default
