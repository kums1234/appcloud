# AI Provider: 'ollama' (free, local) | 'anthropic' (API credits) | 'azure_openai'
AI_PROVIDER=ollama

# ─── Ollama (default, free) ──────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ─── Azure OpenAI (optional) ─────────────────────────────────
