# ─── Anthropic (optional) ────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ─── AppCloud API ─────────────────────────────────────────────
APPCLOUD_API_URL=http://localhost:3000
