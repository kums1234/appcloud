/**
 * integration_tests/tests/governance.test.js
 *
 * Tests the governance and compliance endpoints against
 * a real graph populated by the discovery scan.
 */

const API = process.env.API_URL || 'http://localhost:3001'

async function api(path, opts = {}) {
  const res = await fetch(`${API}${path}`, {
    headers: { 'Content-Type': 'application/json' },
    ...opts,
  })
  const body = await res.json()
  if (!res.ok) throw new Error(`${res.status} ${path}: ${JSON.stringify(body)}`)
  return body
}

// ── Governance summary ─────────────────────────────────────────────────────────
describe('Governance summary', () => {
  test('returns without error on empty or populated graph', async () => {
    const summary = await api('/governance/summary')
    expect(summary).toHaveProperty('totalViolations')
    expect(summary).toHaveProperty('bySeverity')
    expect(summary.totalViolations).toBeGreaterThanOrEqual(0)
  })

  test('bySeverity contains expected keys', async () => {
    const summary = await api('/governance/summary')
    expect(summary.bySeverity).toHaveProperty('CRITICAL')
    expect(summary.bySeverity).toHaveProperty('HIGH')
    expect(summary.bySeverity).toHaveProperty('MEDIUM')
    expect(summary.bySeverity).toHaveProperty('LOW')
  })
})

// ── Policy violations ─────────────────────────────────────────────────────────
describe('Policy violations', () => {
  let violations

  beforeAll(async () => {
    violations = await api('/governance/policy-violations')
  })

  test('returns an array', () => {
    expect(Array.isArray(violations)).toBe(true)
  })

  test('each violation has required fields', () => {
    for (const v of violations) {
      expect(v).toHaveProperty('policy')
      expect(v).toHaveProperty('severity')
      expect(v).toHaveProperty('resource')
      expect(['CRITICAL', 'HIGH', 'MEDIUM', 'LOW']).toContain(v.severity)
    }
  })

  test('NO_OWNER violation fires for apps without owner', async () => {
    // Create an ownerless app
    const app = await api('/applications', {
      method: 'POST',
      body: JSON.stringify({
        name: 'ownerless-app', tier: 1,
        environment: 'test',
        availability: '99.9', confidentiality: 'internal',
        // deliberately no owner field
      }),
    })

    const fresh = await api('/governance/policy-violations')
    const hit = fresh.find(v => v.policy === 'NO_OWNER' &&
      v.resource?.toLowerCase().includes('ownerless'))
    expect(hit).toBeDefined()

    // Cleanup
    await api(`/applications/${app.id}`, { method: 'DELETE' }).catch(() => {})
  })
})

// ── Risk heatmap ──────────────────────────────────────────────────────────────
describe('Risk heatmap', () => {
  test('returns array of risk entries', async () => {
    const heatmap = await api('/governance/risk-heatmap')
    expect(Array.isArray(heatmap)).toBe(true)
  })

  test('each entry has tier and riskScore', async () => {
    const heatmap = await api('/governance/risk-heatmap')
    for (const entry of heatmap) {
      expect(entry).toHaveProperty('tier')
      expect(entry).toHaveProperty('riskScore')
    }
  })
})

// ── Change audit ──────────────────────────────────────────────────────────────
describe('Change audit', () => {
  test('returns without error', async () => {
    const audit = await api('/governance/change-audit')
    expect(Array.isArray(audit)).toBe(true)
  })
})

// ── Compliance report ─────────────────────────────────────────────────────────
describe('Compliance report', () => {
  test('returns structured report', async () => {
    const report = await api('/governance/compliance-report')
    expect(report).toHaveProperty('generatedAt')
    expect(report).toHaveProperty('summary')
    expect(report).toHaveProperty('violations')
  })

  test('summary counts are non-negative', async () => {
    const report = await api('/governance/compliance-report')
    expect(report.summary.totalApplications).toBeGreaterThanOrEqual(0)
    expect(report.summary.totalViolations).toBeGreaterThanOrEqual(0)
    expect(report.summary.complianceScore).toBeGreaterThanOrEqual(0)
    expect(report.summary.complianceScore).toBeLessThanOrEqual(100)
  })
})