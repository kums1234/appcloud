/**
 * integration_tests/tests/workflows.test.js
 *
 * Tests the Workflows endpoints — specifically drift detection,
 * which previously returned 500 due to empty-graph edge cases.
 */

const API = process.env.API_URL || 'http://localhost:3001'

async function api(path, opts = {}) {
  const res = await fetch(`${API}${path}`, {
    headers: { 'Content-Type': 'application/json' },
    ...opts,
  })
  const body = await res.json()
  if (!res.ok) throw new Error(`${res.status} ${path}: ${JSON.stringify(body)}`)
  return body
}

// ── Workflow definitions ───────────────────────────────────────────────────────
describe('Workflow definitions', () => {
  test('returns all three workflow types', async () => {
    const defs = await api('/workflows/definitions')
    expect(Array.isArray(defs)).toBe(true)
    const ids = defs.map(d => d.id)
    expect(ids).toContain('change_lifecycle')
    expect(ids).toContain('app_onboarding')
    expect(ids).toContain('drift_detection')
  })

  test('each definition has required fields', async () => {
    const defs = await api('/workflows/definitions')
    for (const d of defs) {
      expect(d).toHaveProperty('id')
      expect(d).toHaveProperty('name')
      expect(d).toHaveProperty('steps')
      expect(Array.isArray(d.steps)).toBe(true)
      expect(d.steps.length).toBeGreaterThan(0)
    }
  })
})

// ── Workflows summary ─────────────────────────────────────────────────────────
describe('Workflows summary', () => {
  test('summary returns without error on empty graph', async () => {
    const summary = await api('/workflows/summary')
    expect(summary).toHaveProperty('changeLcm')
    expect(summary).toHaveProperty('onboarding')
    expect(summary).toHaveProperty('drift')
  })

  test('summary numeric fields are non-negative', async () => {
    const summary = await api('/workflows/summary')
    expect(summary.changeLcm.total).toBeGreaterThanOrEqual(0)
    expect(summary.onboarding.total).toBeGreaterThanOrEqual(0)
    expect(summary.drift.total).toBeGreaterThanOrEqual(0)
    expect(summary.drift.unmapped).toBeGreaterThanOrEqual(0)
  })
})

// ── Drift detection ────────────────────────────────────────────────────────────
describe('Drift detection', () => {
  test('GET /workflows/drift returns without 500', async () => {
    const drift = await api('/workflows/drift')
    expect(drift).toHaveProperty('graphTerraformResources')
    expect(drift).toHaveProperty('staleResources')
    expect(drift).toHaveProperty('recentImports')
    expect(Array.isArray(drift.recentImports)).toBe(true)
  })

  test('drift counts are non-negative integers', async () => {
    const drift = await api('/workflows/drift')
    expect(drift.graphTerraformResources).toBeGreaterThanOrEqual(0)
    expect(drift.staleResources).toBeGreaterThanOrEqual(0)
  })

  test('GET /workflows/drift/analysis returns without 500', async () => {
    const analysis = await api('/workflows/drift/analysis')
    expect(analysis).toHaveProperty('infraNodes')
    expect(analysis).toHaveProperty('unmapped')
    expect(Array.isArray(analysis.unmapped)).toBe(true)
  })

  test('after discovery scan, drift shows infra nodes', async () => {
    // Run a scan first to populate infra nodes
    await api('/discovery/scan/aws', {
      method: 'POST',
      body: JSON.stringify({
        regions: ['us-east-1'],
        credentials: {
          accessKeyId:     process.env.AWS_ACCESS_KEY_ID     || 'test',
          secretAccessKey: process.env.AWS_SECRET_ACCESS_KEY || 'test',
        },
      }),
    })

    const drift = await api('/workflows/drift')
    expect(drift.graphTerraformResources).toBeGreaterThan(0)
  }, 60_000)

  test('POST /workflows/drift/create-changes works on unmapped resources', async () => {
    const result = await api('/workflows/drift/create-changes', {
      method: 'POST',
      body: JSON.stringify({}),
    })
    // Either creates changes or reports nothing to do — both are valid
    expect(result).toHaveProperty('created')
    expect(result.created).toBeGreaterThanOrEqual(0)
  })
})

// ── Change lifecycle ──────────────────────────────────────────────────────────
describe('Change lifecycle workflow', () => {
  let changeId

  beforeAll(async () => {
    // Create a test application and change
    const app = await api('/applications', {
      method: 'POST',
      body: JSON.stringify({
        name: 'workflow-test-app', tier: 2,
        owner: 'test-team', environment: 'test',
        availability: '99.9', confidentiality: 'internal',
      }),
    })

    const change = await api('/changes', {
      method: 'POST',
      body: JSON.stringify({
        title:         'Test deployment',
        description:   'Integration test change',
        type:          'deployment',
        riskScore:     3,
        applicationId: app.id,
        submittedBy:   'test-runner',
      }),
    })
    changeId = change.id
  })

  test('workflow changes list returns array', async () => {
    const changes = await api('/workflows/changes')
    expect(Array.isArray(changes)).toBe(true)
  })

  test('can advance a change through policy_check step', async () => {
    if (!changeId) return
    const result = await api(`/workflows/changes/${changeId}`, {
      method: 'POST',
      body: JSON.stringify({ action: 'pass_policy' }),
    })
    expect(result).toHaveProperty('workflowStatus')
    expect(result.workflowStatus).toBe('in_review')
  })
})

// ── App onboarding workflow ───────────────────────────────────────────────────
describe('App onboarding workflow', () => {
  test('onboarding list returns array', async () => {
    const onboarding = await api('/workflows/onboarding')
    expect(Array.isArray(onboarding)).toBe(true)
  })

  test('each onboarding entry has completion percentage', async () => {
    const onboarding = await api('/workflows/onboarding')
    for (const o of onboarding) {
      expect(o).toHaveProperty('completionPct')
      expect(o.completionPct).toBeGreaterThanOrEqual(0)
      expect(o.completionPct).toBeLessThanOrEqual(100)
    }
  })
})